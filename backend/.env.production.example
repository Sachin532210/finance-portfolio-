# ---------------------------------------------------------------------------
# Production environment template.
#
# Do NOT commit the filled-in version. On Render, Koyeb or Fly these are set in
# the dashboard rather than in a file.
#
# Differences from local development that actually matter:
#   ENVIRONMENT=production  ->  session cookie gets the Secure flag (HTTPS only)
#   DEBUG=False             ->  exception text is no longer returned to clients
#   SECRET_KEY              ->  must be new; the dev value is in your git history
#   CORS_ORIGINS            ->  your real frontend origin, never "*"
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=False

# --- Database ---------------------------------------------------------------
# TiDB Cloud Serverless (MySQL-compatible, free tier, works with PyMySQL as-is).
# Port is 4000 on TiDB; Aiven and most other MySQL hosts use 3306.
DB_ENGINE=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=LYNY4kiS1aocu27.root
DB_PASSWORD=<paste-the-generated-tidb-password>
DB_NAME=finance_track

# TiDB Cloud's public endpoint requires TLS. This is enabled automatically for
# any non-local DB_HOST, so you normally do not set these at all.
#   DB_SSL=true          force TLS on (or false to force it off)
#   DB_SSL_CA=/path.pem  custom CA bundle; blank uses certifi

# Or set DATABASE_URL to override every DB_* value above. Useful for hosts that
# hand you a single connection string.
# DATABASE_URL=mysql+pymysql://user:pass@host:4000/finance_track?charset=utf8mb4
#
# To use PostgreSQL instead (Neon, Supabase, Render Postgres), set
# DB_ENGINE=postgresql and DB_PORT=5432, and add `psycopg[binary]` to
# requirements.txt - the app ships with the MySQL driver only.

# --- Auth -------------------------------------------------------------------
# Generate a fresh one: python -c "import secrets; print(secrets.token_hex(48))"
# Rotating this signs everyone out.
SECRET_KEY=<generate-a-new-64-plus-character-random-string>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS -------------------------------------------------------------------
# Your deployed frontend origin. Comma-separated for more than one.
# Unnecessary when the frontend proxies /api through its own domain (the setup
# in vercel.json), but required if anything calls the API cross-origin.
CORS_ORIGINS=https://your-app.vercel.app

# --- AI (optional) ----------------------------------------------------------
# Leave blank to run on the built-in financial engine. It uses the same
# calculations, invents nothing, and costs nothing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200

# --- Live market data (optional) --------------------------------------------
# Without a key every investment price is labelled "user-entered".
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_API_KEY=
